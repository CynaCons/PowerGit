{
  "name": "powergit",
  "private": true,
  "version": "0.13.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n engine,ui -c cyan,green \"npm run engine\" \"vite\"",
    "engine": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/engine.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:unit": "vitest run",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:resolution": "playwright test --config playwright.resolution.config.ts",
    "test:live": "node scripts/test-live.mjs",
    "test:perf": "node scripts/perf-run.mjs",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "tauri icon src/assets/app-icon.svg"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@shikijs/engine-javascript": "4.4.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.69.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
